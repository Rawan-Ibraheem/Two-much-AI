# Copy to backend/.env (git-ignored) or set these in your shell.
# server.js also reads ../shared/.env, so a key already placed there is picked up.

# Port the REST API listens on.
PORT=3000

# Anthropic API key, used only for query normalization (Arabic / Franco Arabic /
# misspellings) when the deterministic search finds nothing.
# BACKEND ONLY - never expose this to the browser or prefix it with VITE_.
# Leave unset and search still works; the AI fallback simply reports "disabled".
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Set to "off" to disable the Claude fallback entirely (used by the test suite,
# and a useful kill switch if the network is unreliable during a demo).
# AI_ASSIST=off
